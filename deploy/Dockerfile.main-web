FROM node:24-alpine AS build

RUN corepack enable
WORKDIR /src
COPY . .

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @ielts/main-web build

FROM node:24-alpine AS runtime
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
WORKDIR /app

COPY --from=build /src/apps/main-web/.next/standalone ./
COPY --from=build /src/apps/main-web/public ./apps/main-web/public
COPY --from=build /src/apps/main-web/.next/static ./apps/main-web/.next/static

WORKDIR /app/apps/main-web
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --spider -q http://127.0.0.1:3000/ || exit 1

CMD ["node", "server.js"]
